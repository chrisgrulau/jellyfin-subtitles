<Project Sdk="Microsoft.NET.Sdk">

  <!-- A developer tool for calibrating the whole-file check on real videos; not part of the solution, CI or the plugin
       zip. Usage: see the header of Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DiscrepancyEval</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AnalysisMode>Default</AnalysisMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Jellyfin.Plugin.Subtitles/Jellyfin.Plugin.Subtitles.csproj" />
  </ItemGroup>

</Project>
