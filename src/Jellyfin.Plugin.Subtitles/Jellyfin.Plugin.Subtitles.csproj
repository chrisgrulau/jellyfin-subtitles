<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.Subtitles</RootNamespace>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provided by the Jellyfin server at runtime: compile against them, don't ship them -->
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.1.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Shared source (resilience, budgets, spend tracking), compiled in as internal code; see external/common -->
  <Import Project="../../external/common/Common.props" />

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.Subtitles.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
